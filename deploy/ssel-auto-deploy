#!/usr/bin/env bash
set -Eeuo pipefail

readonly APP_DIR="${CAT_APP_DIR:?Set CAT_APP_DIR in the deployment environment file}"
readonly APP_USER="${CAT_APP_USER:?Set CAT_APP_USER in the deployment environment file}"
readonly BRANCH="${CAT_BRANCH:-main}"
readonly REPOSITORY="${CAT_REPOSITORY:-jeongk31/ssel_llm_tool}"
readonly STATE_DIR="${CAT_STATE_DIR:-/var/lib/ssel-chat-deploy}"
readonly DEPLOYED_SHA_FILE="${STATE_DIR}/deployed-sha"
readonly LOCK_FILE="/run/lock/ssel-chat-deploy.lock"

exec 9>"${LOCK_FILE}"
if ! flock -n 9; then
  echo "Another deployment is already running."
  exit 0
fi

run_as_app() {
  runuser -u "${APP_USER}" -- "$@"
}

cd "${APP_DIR}"

if ! run_as_app git diff --quiet || ! run_as_app git diff --cached --quiet; then
  echo "Refusing to deploy: ${APP_DIR} has tracked local changes." >&2
  exit 1
fi

run_as_app git fetch --quiet origin "${BRANCH}"
target_sha="$(run_as_app git rev-parse "origin/${BRANCH}")"
deployed_sha="$(cat "${DEPLOYED_SHA_FILE}" 2>/dev/null || true)"

if [[ "${target_sha}" == "${deployed_sha}" ]]; then
  echo "Already deployed: ${target_sha}"
  exit 0
fi

workflow_json="$(
  curl --fail --silent --show-error \
    --header "Accept: application/vnd.github+json" \
    --header "User-Agent: ssel-auto-deploy" \
    "https://api.github.com/repos/${REPOSITORY}/actions/workflows/ci.yml/runs?branch=${BRANCH}&event=push&per_page=20"
)"

ci_conclusion="$(
  TARGET_SHA="${target_sha}" python3 -c '
import json
import os
import sys

payload = json.load(sys.stdin)
target = os.environ["TARGET_SHA"]
matching = [run for run in payload.get("workflow_runs", []) if run.get("head_sha") == target]
print(matching[0].get("conclusion") or matching[0].get("status") if matching else "missing")
' <<<"${workflow_json}"
)"

if [[ "${ci_conclusion}" != "success" ]]; then
  echo "Not deploying ${target_sha}: CI status is ${ci_conclusion}."
  exit 0
fi

current_branch="$(run_as_app git branch --show-current)"
if [[ "${current_branch}" != "${BRANCH}" ]]; then
  echo "Refusing to deploy: expected branch ${BRANCH}, found ${current_branch:-detached HEAD}." >&2
  exit 1
fi

run_as_app git merge --ff-only "origin/${BRANCH}"

run_as_app "${APP_DIR}/.venv-server/bin/python" -m pip install \
  --disable-pip-version-check \
  --requirement "${APP_DIR}/backend/requirements.txt"

run_as_app env \
  HOME="/home/${APP_USER}" \
  PATH="/usr/local/bin:/usr/bin:/bin" \
  npm --prefix "${APP_DIR}/frontend" ci

run_as_app env \
  HOME="/home/${APP_USER}" \
  PATH="/usr/local/bin:/usr/bin:/bin" \
  npm --prefix "${APP_DIR}/frontend" run build

systemctl restart ssel-backend.service ssel-frontend.service

for attempt in {1..20}; do
  if curl --fail --silent --show-error "http://127.0.0.1:8000/" >/dev/null \
    && curl --fail --silent --show-error "http://127.0.0.1:3000/" >/dev/null; then
    printf '%s\n' "${target_sha}" >"${DEPLOYED_SHA_FILE}"
    echo "Deployment complete: ${target_sha}"
    exit 0
  fi
  sleep 1
done

echo "Deployment failed health checks." >&2
systemctl status ssel-backend.service ssel-frontend.service --no-pager >&2 || true
exit 1
