[Unit]
Description=Deploy the latest CI-approved ChAT release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ssel-auto-deploy

# Restrict the root service while retaining the paths and systemd access needed
# to update the application and restart its two services.
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/ssel-chat /var/lib/ssel-chat-deploy /run/lock
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
