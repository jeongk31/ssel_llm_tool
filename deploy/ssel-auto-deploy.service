[Unit]
Description=Deploy the latest CI-approved CAT release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/ssel-chat-deploy.conf
ExecStart=/usr/local/sbin/ssel-auto-deploy

# Restrict the root service while retaining the paths and systemd access needed
# to update the application and restart its two services.
PrivateTmp=true
ProtectSystem=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
